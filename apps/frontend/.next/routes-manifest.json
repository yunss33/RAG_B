{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/projects/[id]",
      "regex": "^/projects/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/projects/[id]/drafts",
      "regex": "^/projects/([^/]+?)/drafts(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/drafts(?:/)?$"
    },
    {
      "page": "/projects/[id]/final",
      "regex": "^/projects/([^/]+?)/final(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/final(?:/)?$"
    },
    {
      "page": "/projects/[id]/images",
      "regex": "^/projects/([^/]+?)/images(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/images(?:/)?$"
    },
    {
      "page": "/projects/[id]/outline",
      "regex": "^/projects/([^/]+?)/outline(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/outline(?:/)?$"
    },
    {
      "page": "/projects/[id]/requirements",
      "regex": "^/projects/([^/]+?)/requirements(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/requirements(?:/)?$"
    },
    {
      "page": "/projects/[id]/upload",
      "regex": "^/projects/([^/]+?)/upload(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/upload(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/flow",
      "regex": "^/flow(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/flow(?:/)?$"
    },
    {
      "page": "/projects/new",
      "regex": "^/projects/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/projects/new(?:/)?$"
    },
    {
      "page": "/skills",
      "regex": "^/skills(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skills(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}